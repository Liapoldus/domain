{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://liapoldus.github.io/spec/domain/v1/model.schema.json",
  "title": "Domain v1 settings",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "entities"],
  "properties": {
    "schemaVersion": { "const": "1" },
    "entities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": { "$ref": "#/$defs/entity" }
    },
    "migrations": {
      "type": "array",
      "maxItems": 512,
      "items": { "$ref": "#/$defs/mapping" }
    }
  },
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$" },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type"],
      "properties": {
        "name": { "$ref": "#/$defs/identifier" },
        "type": { "enum": ["text", "int64", "decimal", "bool", "timestamp", "bytes"] },
        "primaryKey": { "type": "boolean" },
        "required": { "type": "boolean" },
        "unique": { "type": "boolean" },
        "default": { "type": ["string", "integer", "number", "boolean", "null"] },
        "references": {
          "type": "object",
          "additionalProperties": false,
          "required": ["entity", "field"],
          "properties": {
            "entity": { "$ref": "#/$defs/identifier" },
            "field": { "$ref": "#/$defs/identifier" }
          }
        }
      }
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "ownerGroup", "fields"],
      "properties": {
        "name": { "$ref": "#/$defs/identifier" },
        "ownerGroup": { "$ref": "#/$defs/identifier" },
        "fields": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": { "$ref": "#/$defs/field" }
        }
      }
    },
    "mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entity", "from", "to"],
      "properties": {
        "entity": { "$ref": "#/$defs/identifier" },
        "from": { "$ref": "#/$defs/identifier" },
        "to": { "$ref": "#/$defs/identifier" },
        "conversion": { "enum": ["parseInt64", "formatInt64"] }
      }
    }
  }
}
