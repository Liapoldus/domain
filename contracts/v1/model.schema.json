{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://liapoldus.github.io/spec/domain/v1/model.schema.json",
  "title": "Domain v1 settings",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "entities"
  ],
  "properties": {
    "entities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entity"
      },
      "minItems": 1,
      "maxItems": 256
    },
    "migrations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/mapping"
      },
      "maxItems": 512
    },
    "schemaVersion": {
      "const": "1"
    }
  },
  "$defs": {
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "ownerGroup",
        "fields"
      ],
      "properties": {
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/field"
          },
          "minItems": 1,
          "maxItems": 128
        },
        "name": {
          "$ref": "#/$defs/identifier"
        },
        "ownerGroup": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "type"
      ],
      "properties": {
        "default": {
          "type": [
            "string",
            "integer",
            "number",
            "boolean",
            "null"
          ]
        },
        "name": {
          "$ref": "#/$defs/identifier"
        },
        "primaryKey": {
          "type": "boolean"
        },
        "references": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "entity",
            "field"
          ],
          "properties": {
            "entity": {
              "$ref": "#/$defs/identifier"
            },
            "field": {
              "$ref": "#/$defs/identifier"
            }
          }
        },
        "required": {
          "type": "boolean"
        },
        "type": {
          "enum": [
            "text",
            "int64",
            "decimal",
            "bool",
            "timestamp",
            "bytes"
          ]
        },
        "unique": {
          "type": "boolean"
        }
      }
    },
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
    },
    "mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entity",
        "from",
        "to"
      ],
      "properties": {
        "conversion": {
          "enum": [
            "parseInt64",
            "formatInt64"
          ]
        },
        "entity": {
          "$ref": "#/$defs/identifier"
        },
        "from": {
          "$ref": "#/$defs/identifier"
        },
        "to": {
          "$ref": "#/$defs/identifier"
        }
      }
    }
  }
}
